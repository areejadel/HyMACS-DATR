# Environment variables. Copy this file to .env and fill in your keys.
# Never commit .env.

# --- API keys (three providers) ---
TOGETHER_API_KEY=your_together_key_here     # hosted generators + Kimi/GLM judges
OPENAI_API_KEY=your_openai_key_here         # inner judge (GPT-4o)
ANTHROPIC_API_KEY=your_anthropic_key_here   # Claude panel judge

# --- ALLaM local backend ---
# "local" = llama.cpp + GGUF (Apple Metal / CPU); "mlx" = Apple Silicon native
ALLAM_BACKEND=local
ALLAM_GGUF_PATH=./models/allam-7b-instruct-q4_k_m.gguf

# --- Experiment hyperparameters ---
TEMPERATURE_GEN=0.7
TEMPERATURE_EVAL=0.2
MAX_ITERATIONS=3
QUALITY_THRESHOLD=8.5
REGRESSION_TOLERANCE=0.5
PILOT_SEEDS=5

# --- Subject + RAG ---
TOPIC=backprop                              # backprop | normalization
BACKPROP_TEXTBOOK=./books/deep_learning_ch6.pdf
NORMALIZATION_TEXTBOOK=./books/database_systems.pdf
RAG_ENABLED=1                               # set 0 to disable textbook grounding
RAG_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=6

# --- External judge panel ---
USE_PANEL=1                                 # 1 = three-judge panel; 0 = single judge
